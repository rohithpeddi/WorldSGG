# INFRA (rebuttal): job environment on cs94092. Installed as /data3/rohith/wsgg/host.env.
# Nothing is copied to this host: env, code, data, grids and outputs are CS93371 directories served as sshfs mounts
# under /data3/rohith/wsgg/mnt/ (tools/rebuttal/infra_mount.sh, tmux reb_infra_mnt_cs94092 on CS93371).
# A job script selects its host file by $REB_HOST (set by gpuq_worker.sh):
#   case $REB_HOST in cs94085) . /data1/rohith/wsgg/host.env ;; cs94092) . /data3/rohith/wsgg/host.env ;;
#                     *) . /data3/rohith/ag/runs/rebuttal/infra/host_cs93371.env ;; esac
#   cd $WSGG_CODE; CFG=$(bash $WSGG_INFRA/infra_hostcfg.sh configs/methods/<mode>/<cfg>.yaml); OUT=$(hp /data3/...)
# NEVER run du / find / rm -r on /data3/rohith/wsgg or its mnt/ directory: it walks into CS93371's disks.
export REB_SITE=cs94092
M=/data3/rohith/wsgg/mnt
export PY=$M/env/bin/python                 # CS93371 ~/anaconda3/envs/scene4cast (ro). cv2 does not import from here.
export WSGG_CODE=$M/code                    # CS93371 ~/CODE/Scene4Cast_rebuttal_train (rw)
export WSGG_DATA=$M/data                    # CS93371 /data/rohith/ag (ro)              = config data_path
export WSGG_GRIDS=$M/grids                  # CS93371 /code/rohith/ag/cache/pp_grids (ro) = config grid_cache_root
export WSGG_RUNS_RO=$M/runs                 # CS93371 /data3/rohith/ag/runs (ro)        existing checkpoints / dumps
export WSGG_OUT=$M/reb                      # CS93371 /data3/rohith/ag/runs/rebuttal (rw) job outputs
export WSGG_LOCAL=/data3/rohith/wsgg/runs   # small local scratch on cs94092
export WSGG_QUEUE=/data3/rohith/wsgg/queue
export WSGG_INFRA=/data3/rohith/wsgg/infra
unset M
# hp <CS93371 path> -> the same file as seen from this host (identity for paths outside the mounts)
hp() {
  case "$1" in
    /data3/rohith/ag/runs/rebuttal*) echo "$WSGG_OUT${1#/data3/rohith/ag/runs/rebuttal}" ;;
    /data3/rohith/ag/runs*)          echo "$WSGG_RUNS_RO${1#/data3/rohith/ag/runs}" ;;
    /data3/rohith/ag/cache/pp_grids*) echo "$WSGG_GRIDS${1#/data3/rohith/ag/cache/pp_grids}" ;;
    /code/rohith/ag/cache/pp_grids*) echo "$WSGG_GRIDS${1#/code/rohith/ag/cache/pp_grids}" ;;
    /data/rohith/ag*)                echo "$WSGG_DATA${1#/data/rohith/ag}" ;;
    "$HOME"/CODE/Scene4Cast_rebuttal_train*) echo "$WSGG_CODE${1#$HOME/CODE/Scene4Cast_rebuttal_train}" ;;
    *) echo "$1" ;;
  esac
}
export -f hp
# keep every cache on /data3 (systemd-oomd host; / is shared)
export TMPDIR=/data3/rohith/wsgg/tmp
export PIP_CACHE_DIR=$TMPDIR/pip XDG_CACHE_HOME=$TMPDIR/xdg_cache MPLCONFIGDIR=$TMPDIR/mpl TORCH_HOME=$TMPDIR/torch
export TRITON_CACHE_DIR=$TMPDIR/triton HF_HOME=$TMPDIR/hf
export WANDB_DIR=$TMPDIR/wandb WANDB_CACHE_DIR=$TMPDIR/wandb_cache WANDB_CONFIG_DIR=$TMPDIR/wandb_config
export WANDB_MODE=${WANDB_MODE:-offline}    # no wandb login on this host
export PYTHONDONTWRITEBYTECODE=1            # keep __pycache__ writes off the code mount
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
mkdir -p "$TMPDIR" "$PIP_CACHE_DIR" "$XDG_CACHE_HOME" "$MPLCONFIGDIR" "$TORCH_HOME" "$TRITON_CACHE_DIR" "$HF_HOME" \
         "$WANDB_DIR" "$WANDB_CACHE_DIR" "$WANDB_CONFIG_DIR" "$WSGG_LOCAL" 2>/dev/null
# fail early if a mount is missing or dead
for _m in "$PY" "$WSGG_CODE/wsgg_base.py" "$WSGG_DATA/features" "$WSGG_GRIDS/test" "$WSGG_OUT"; do
  [ -e "$_m" ] || { echo "host.env: $_m not reachable (sshfs mount down? see INFRA.md)" >&2; return 3 2>/dev/null || exit 3; }
done
unset _m
