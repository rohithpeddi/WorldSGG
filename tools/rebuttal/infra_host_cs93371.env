# INFRA (rebuttal): CS93371 counterpart of the remote hosts' host.env, so one job script runs on any host:
#   case $REB_HOST in cs94085) . /data1/rohith/wsgg/host.env ;; cs94092) . /data3/rohith/wsgg/host.env ;;
#                     *) . /data3/rohith/ag/runs/rebuttal/infra/host_cs93371.env ;; esac
# Here every path is CS93371's own: hp is the identity and infra_hostcfg.sh leaves the config unchanged.
export REB_SITE=cs93371
export PY=$HOME/anaconda3/envs/scene4cast/bin/python
export WSGG_CODE=$HOME/CODE/Scene4Cast_rebuttal_train
export WSGG_DATA=/data/rohith/ag
export WSGG_GRIDS=/data3/rohith/ag/cache/pp_grids
export WSGG_RUNS_RO=/data3/rohith/ag/runs
export WSGG_OUT=/data3/rohith/ag/runs/rebuttal
export WSGG_LOCAL=/data3/rohith/ag/runs/rebuttal
export WSGG_QUEUE=/data3/rohith/ag/runs/rebuttal/queue
export WSGG_INFRA=/data3/rohith/ag/runs/rebuttal/infra
hp() { echo "$1"; }
export -f hp
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
